{
  "name": "opencode-file-browser",
  "version": "1.1.0",
  "description": "File browser, editor and git panel for the OpenCode TUI. A mini IDE for your terminal: tabs, syntax colours, diffs and commits.",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "file-browser",
    "file-viewer",
    "markdown",
    "syntax-highlighting",
    "file-explorer",
    "editor",
    "ide",
    "git",
    "diff",
    "opencode-editor",
    "opencode-ide",
    "mini-ide",
    "terminal-editor",
    "code-editor",
    "git-panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurrogado/opencode-file-browser.git"
  },
  "homepage": "https://arthurrogado.github.io/opencode-file-browser/",
  "bugs": {
    "url": "https://github.com/arthurrogado/opencode-file-browser/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "scripts": {
    "bundle": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run bundle",
    "prepack": "node scripts/strip-dev.mjs",
    "postpack": "node scripts/restore-dev.mjs",
    "test:unit": "node --test test/unit.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
