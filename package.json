{
  "name": "opencode-file-browser",
  "version": "1.0.1",
  "description": "Browse, edit and review files and git changes inside the OpenCode TUI",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "file-browser",
    "file-viewer",
    "markdown",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurrogado/opencode-file-browser.git"
  },
  "homepage": "https://arthurrogado.github.io/opencode-file-browser/",
  "bugs": {
    "url": "https://github.com/arthurrogado/opencode-file-browser/issues"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "scripts": {
    "bundle": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run bundle",
    "setup": "npm install --no-save --legacy-peer-deps typescript @types/node @babel/core @babel/preset-typescript babel-preset-solid @opencode/plugin@2.2.5 @opencode/client@2.2.5 @opencode/theme@2.2.5 @opentui/core@0.8.4 @opentui/solid@0.8.4 solid-js"
  }
}
